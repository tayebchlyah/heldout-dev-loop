prefix_rule(pattern=["/bin/zsh", "-lc", "CURL_IN=\"$(cat workflows/curl.txt)\"; FULL_URL=\"$(printf '%s\\n' \"$CURL_IN\" | sed -nE \"s/^curl[[:space:]]+'([^']+)'.*/\\1/p\" | head -n 1)\"; BROWSER_ID=\"$(printf '%s\\n' \"$CURL_IN\" | sed -nE \"s/^[[:space:]]*-H[[:space:]]+'browser-id:[[:space:]]*([^']+)'.*/\\1/p\" | head -n 1)\"; COOKIE_LINE=\"$(printf '%s\\n' \"$CURL_IN\" | sed -nE \"s/^[[:space:]]*-b[[:space:]]+'([^']+)'.*/\\1/p\" | head -n 1)\"; BASE_URL=\"${FULL_URL%/active-workflows}\"; for ep in \"workflows/Knr2G4jd3ttImFBm/publish\" \"workflows/Knr2G4jd3ttImFBm/activate\" \"workflows/Knr2G4jd3ttImFBm/deactivate\" \"workflows/Knr2G4jd3ttImFBm/history\" \"workflows/Knr2G4jd3ttImFBm/versions\" \"workflows/Knr2G4jd3ttImFBm/published\"; do code=$(curl -sS -o /tmp/n8n_publish_probe -w '%{http_code}' \"$BASE_URL/$ep\" -X GET -H \"accept: application/json, text/plain, */*\" -H \"browser-id: $BROWSER_ID\" -b \"$COOKIE_LINE\"); printf '%s %s\\n' \"$code\" \"$ep\"; done"], decision="allow")
