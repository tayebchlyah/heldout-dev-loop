{
  "version": "3.0.0",
  "harnesses": [
    "claude",
    "codex"
  ],
  "capabilities": [],
  "release_notes": "written",
  "version_files": [
    "package.json",
    "package-lock.json"
  ],
  "commands": {
    "acceptance": "scripts/acceptance.sh",
    "release_prepare": "node bin/install.mjs upgrade",
    "release_check": "scripts/release-check.sh",
    "release_verify": "scripts/release-verify.sh"
  },
  "security_audit": {
    "images": {
      "audit": "dev-loop-audit:1"
    }
  },
  "file_size_exempt": [
    "CHANGELOG.md",
    "tests/unit/python/fixtures/git-guard-asks.json"
  ],
  "source_dirs": [
    "skill/",
    "skills/",
    "lib/",
    "bin/",
    "claude/",
    "codex/",
    "tests/unit/",
    ".agents/",
    ".claude/",
    ".codex/",
    ".dev-loop/"
  ],
  "merge_human_paths": [
    ".github/*",
    "scripts/*",
    "tests/unit/python/test_dev_loop.py",
    "tests/unit/python/junit_report.py"
  ]
}
