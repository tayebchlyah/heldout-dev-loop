prefix_rule(
    pattern=[["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "push"],
    decision="prompt",
    justification="Global rule: git push needs explicit permission each time.",
    match=["git push origin main", "/usr/bin/git push origin main", "/opt/homebrew/bin/git push"],
    not_match=["git status", "git pull"],
)
prefix_rule(
    pattern=[["gh", "/usr/bin/gh", "/opt/homebrew/bin/gh"], "api"],
    decision="prompt",
    justification="Global rule: gh api can write refs, releases and branch protection, so it needs explicit permission each time.",
    match=["gh api -X POST repos/o/r/releases", "/opt/homebrew/bin/gh api repos/o/r"],
    not_match=["gh pr view 7", "gh release list"],
)
prefix_rule(
    pattern=[["gh", "/usr/bin/gh", "/opt/homebrew/bin/gh"], "release"],
    decision="prompt",
    justification="Global rule: gh release can create, edit or delete a release, so it needs explicit permission each time.",
    match=["gh release delete v1.0.0", "/usr/bin/gh release create v9.9.9"],
    not_match=["gh pr view 7", "gh api repos/o/r"],
)
prefix_rule(
    pattern=["git", "-C"],
    decision="prompt",
    justification="Git with a directory override needs review because later arguments can hide a push or destructive write.",
    match=["git -C /tmp/repo push origin main", "git -C /tmp/repo reset --hard HEAD"],
    not_match=["git status"],
)
prefix_rule(
    pattern=[["git", "/usr/bin/git", "/opt/homebrew/bin/git"], "reset", "--hard"],
    decision="forbidden",
    justification="Hard reset can destroy uncommitted work.",
    match=["git reset --hard HEAD", "/usr/bin/git reset --hard HEAD", "/opt/homebrew/bin/git reset --hard"],
    not_match=["git reset --soft HEAD", "git status"],
)
prefix_rule(
    pattern=["rm", "-rf", "/"],
    decision="forbidden",
    justification="Recursive deletion of filesystem root is never allowed.",
    match=["rm -rf /"],
    not_match=["rm -rf /tmp/example"],
)
