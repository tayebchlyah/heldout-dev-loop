{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Checking repository workflow"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/board.sh\" session-start",
            "timeout": 5,
            "statusMessage": "Updating dev-loop board"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/git-guard.sh\"",
            "timeout": 30,
            "statusMessage": "Checking command safety"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|view_image|mcp__.*|read_mcp_resource|list_mcp_resources|list_mcp_resource_templates",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/acceptance-wall.sh\"",
            "timeout": 30,
            "statusMessage": "Checking held-out suite access"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/gate.sh\"",
            "timeout": 600,
            "statusMessage": "Running repository gate"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/seal.sh\" turn",
            "timeout": 120,
            "statusMessage": "Checking held-out seal"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/gate.sh\"",
            "timeout": 600,
            "statusMessage": "Running repository gate"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/seal.sh\" stop",
            "timeout": 120,
            "statusMessage": "Checking held-out seal"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/board.sh\" prompt",
            "timeout": 5,
            "statusMessage": "Updating dev-loop board"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/board.sh\" post-tool",
            "timeout": 5,
            "statusMessage": "Updating dev-loop board"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.dev-loop/hooks/codex/seal.sh\" start",
            "timeout": 5,
            "statusMessage": "Recording subagent start"
          }
        ]
      }
    ]
  }
}
